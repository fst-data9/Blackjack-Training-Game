{
  "name": "blackjack-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check migrate.js && node --check provision-db-role.js && node migrate.js --check",
    "migrate": "node migrate.js",
    "migrate:check": "node migrate.js --check",
    "db:provision": "node provision-db-role.js",
    "db:prepare": "node migrate.js && node provision-db-role.js",
    "test:database": "node --test --test-concurrency=1 tests/database.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "pg": "^8.12.0"
  }
}
