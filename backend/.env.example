DATABASE_URL=postgres://blackjack:change-this-long-random-password@postgres:5432/blackjack
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
ALLOW_FILE_ORIGIN=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TRUST_PROXY_HOPS=0
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=6000
DB_STATEMENT_TIMEOUT_MS=5000
# Optional: enables the Google button. Create a Web client ID in Google Cloud.
GOOGLE_CLIENT_ID=
# Optional locally; strongly recommended and enforceable in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
REQUIRE_SIGNUP_CAPTCHA=false
