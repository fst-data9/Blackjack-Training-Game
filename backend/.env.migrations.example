# Release/admin credentials only. Never put these values in backend/.env.
# Keep the existing POSTGRES_USER as the owner of your existing database.
DATABASE_URL=postgres://blackjack:change-this-long-random-password@postgres:5432/blackjack
DATABASE_APP_USER=blackjack_api
DATABASE_APP_PASSWORD=change-this-separate-long-random-password
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=65000
DB_STATEMENT_TIMEOUT_MS=60000
