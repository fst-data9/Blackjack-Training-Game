[Unit]
Description=Encrypted Blackjack PostgreSQL backup (%i)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=deploy
SupplementaryGroups=docker
WorkingDirectory=/opt/blackjack
EnvironmentFile=/etc/blackjack/backup-%i.env
ExecStart=/bin/bash /opt/blackjack/scripts/database-backup.sh
UMask=0077
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/var/backups/blackjack/%i

